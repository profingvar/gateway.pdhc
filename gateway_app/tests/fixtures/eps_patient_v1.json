        },
        {
          "linkId": "medication.dose",
          "type": "string",
          "text": "Hur mycket tar du varje gång? Till exempel 1 tablett eller 500 mg."
        },
        {
          "linkId": "medication.frequency",
          "type": "string",
          "text": "Hur ofta tar du det? Till exempel 2 gånger om dagen eller vid behov."
        },
        {
          "linkId": "medication.indication",
