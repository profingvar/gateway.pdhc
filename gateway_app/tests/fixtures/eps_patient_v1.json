          "text": "Vad tar du det för?"
        },
        {
          "linkId": "medication.prescribed",
          "type": "choice",
          "text": "Har en läkare eller sjuksköterska skrivit ut det?",
          "answerOption": [
            {
              "valueCoding": {
                "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
                "code": "yes",
                "display": "Ja"
              }
            },
            {
              "valueCoding": {
                "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
                "code": "no",
                "display": "Nej"
              }
            },
            {
              "valueCoding": {
                "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
                "code": "unknown",
                "display": "Vet inte"
              }
            }
          ]
        }
      ]
    },
    {
