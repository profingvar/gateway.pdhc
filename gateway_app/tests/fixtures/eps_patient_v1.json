{
  "resourceType": "Questionnaire",
  "id": "eps-patient",
  "url": "https://plan.pdhc.se/fhir/Questionnaire/eps-patient",
  "version": "1",
  "name": "EpsPatient",
  "title": "Din patientöversikt – det du själv kan berätta",
  "status": "draft",
  "experimental": true,
  "subjectType": [
    "Patient"
  ],
  "date": "2026-11-22",
  "publisher": "PDHC platform",
  "language": "sv",
  "description": "Patientens egna uppgifter till patientöversikten (EPS): allergier, läkemedel, tidigare sjukdomar, vaccinationer och kontaktpersoner. Svaren lagras som patientgenererade och når patientöversikten först när vården har godkänt dem (#1044). Diagnoser ingår inte: de kommer från vården. Varje avsnitt börjar med ett uttryckligt val, så att 'inga kända' är ett svar och inte ett tomt avsnitt. Fritext förblir fritext: formuläret kodar ingenting.",
  "meta": {
    "tag": [
      {
        "system": "https://pdhc.se/fhir/tag",
        "code": "eps-review"
      }
    ]
  },
  "item": [
    {
      "linkId": "intro",
      "type": "display",
      "text": "Här kan du själv berätta om dina allergier, läkemedel, tidigare sjukdomar, vaccinationer och kontaktpersoner. Skriv med egna ord. Vården läser dina svar och godkänner dem innan de förs in i din patientöversikt. Diagnoser fyller du inte i här – de kommer från vården."
    },
    {
      "linkId": "allergy.intro",
      "type": "display",
      "text": "Allergier och överkänslighet. Till exempel mot läkemedel, mat, pollen, pälsdjur eller latex."
    },
    {
      "linkId": "allergy.status",
      "type": "choice",
      "required": true,
      "text": "Har du någon allergi eller överkänslighet?",
      "answerOption": [
        {
          "valueCoding": {
            "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
            "code": "has",
            "display": "Ja, jag har en eller flera allergier eller överkänsligheter"
          }
        },
        {
          "valueCoding": {
            "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
            "code": "none",
            "display": "Jag har inga kända allergier"
          }
        },
        {
          "valueCoding": {
            "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
            "code": "unknown",
            "display": "Jag vet inte"
          }
        }
      ]
    },
    {
      "linkId": "allergy.entry",
      "type": "group",
      "repeats": true,
      "text": "En allergi eller överkänslighet",
      "enableWhen": [
        {
          "question": "allergy.status",
          "operator": "=",
          "answerCoding": {
            "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
            "code": "has"
          }
        }
      ],
      "item": [
        {
          "linkId": "allergy.substance",
          "type": "string",
          "required": true,
          "text": "Vad är du allergisk eller överkänslig mot?"
        },
        {
          "linkId": "allergy.reaction",
          "type": "text",
          "text": "Vad händer när du reagerar? Till exempel utslag, klåda eller svårt att andas."
        },
        {
          "linkId": "allergy.severity",
          "type": "choice",
          "text": "Hur allvarlig brukar reaktionen vara?",
          "answerOption": [
            {
              "valueCoding": {
                "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
                "code": "mild",
                "display": "Lindrig – besvärande men går över av sig själv"
              }
            },
            {
              "valueCoding": {
                "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
                "code": "moderate",
                "display": "Måttlig – jag behöver läkemedel eller vård"
              }
            },
            {
              "valueCoding": {
                "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
                "code": "severe",
                "display": "Allvarlig – till exempel svårt att andas, svullnad i halsen eller svimning"
              }
            },
            {
              "valueCoding": {
                "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
                "code": "unknown",
                "display": "Vet inte"
              }
            }
          ]
        }
      ]
    },
    {
      "linkId": "medication.intro",
      "type": "display",
      "text": "Läkemedel. Ta med allt du använder regelbundet eller vid behov: receptbelagda läkemedel, receptfria läkemedel och kosttillskott."
    },
    {
      "linkId": "medication.status",
      "type": "choice",
      "required": true,
      "text": "Använder du några läkemedel?",
      "answerOption": [
        {
          "valueCoding": {
            "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
            "code": "has",
            "display": "Ja, jag använder ett eller flera läkemedel"
          }
        },
        {
          "valueCoding": {
            "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
            "code": "none",
            "display": "Jag använder inga läkemedel"
          }
        },
        {
          "valueCoding": {
            "system": "https://plan.pdhc.se/fhir/CodeSystem/eps-patient-answer",
            "code": "unknown",
            "display": "Jag vet inte"
          }
        }
      ]
    },
    {
      "linkId": "medication.entry",
      "type": "group",
      "repeats": true,
      "text": "Ett läkemedel",
      "enableWhen": [
        {
          "question": "medication.status",
          "operator": "=",
